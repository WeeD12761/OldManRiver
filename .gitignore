# --- Unreal Engine generated/cache directories (never version these) ---
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/

# Per-platform build junk
*.VC.db
*.VC.VC.opendb
*.opensdf
*.sdf
*.sln.docstates

# IDE / tool folders
.vs/
.vscode/
.idea/

# Unreal auto-generated project files (regenerated by "Generate Project Files")
*.sln
*.xcodeproj
*.xcworkspace

# Crash reports / logs
Saved/Logs/
Saved/Crashes/

# macOS / Windows junk
.DS_Store
Thumbs.db

# Plugin intermediate/binaries (if plugins live in-project)
Plugins/**/Binaries/
Plugins/**/Intermediate/
Plugins/IglooUnrealToolkit_v5.7/IglooPreview.zip
